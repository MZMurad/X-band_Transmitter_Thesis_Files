    label: '"RF Gain"'
    label0: ''
    label1: ''
    label2: ''
    label3: ''
    label4: ''
    labels: '["0.0", "12.5", "20.7", "29.7", "36.4", "40.2", "44.5", "49.6"]'
    num_opts: '0'
    option0: '0'
    option1: '1'
    option2: '2'
    option3: '3'
    option4: '4'
    options: '[0.0, 12.5, 20.7, 29.7, 36.4, 40.2, 44.5, 49.6]'
    orient: Qt.QVBoxLayout
